# Copy to .env and fill in from developer.intuit.com > your app > Keys & credentials (Development / sandbox keys)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/callback
# sandbox | production
QBO_ENVIRONMENT=sandbox
PORT=3000
# Dashboard origin allowed by CORS
WEB_ORIGIN=http://localhost:5173
# P&L window pulled by POST /sync
SYNC_START_DATE=2025-01-01
SYNC_END_DATE=2026-12-31
# Optional
# DB_PATH=./data/pnl.db

# ---- Hosting (not needed for local dev) ----
# Serve the built dashboard (web/dist) from the server on one origin. `npm start` sets these.
# NODE_ENV=production
# SERVE_WEB=1
# Public HTTPS URL of the deployment; QBO_REDIRECT_URI defaults to <PUBLIC_URL>/callback.
# PUBLIC_URL=https://your-app.up.railway.app
# Basic-auth login for the whole app. Set both, or the hosted dashboard is open to anyone with the URL.
# APP_USER=admin
# APP_PASSWORD=change-me
# SQLite on the host's persistent disk (e.g. a Railway/Fly volume mounted at /data)
# DB_PATH=/data/pnl.db
