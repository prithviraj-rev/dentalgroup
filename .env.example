# Copy to .env and fill in from developer.intuit.com > your app > Keys & credentials (Development / sandbox keys)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/callback
# sandbox | production
QBO_ENVIRONMENT=sandbox
PORT=3000
# Dashboard origin allowed by CORS
WEB_ORIGIN=http://localhost:5173
# P&L window pulled by POST /sync
SYNC_START_DATE=2025-01-01
SYNC_END_DATE=2026-12-31
# Optional
# DB_PATH=./data/pnl.db
