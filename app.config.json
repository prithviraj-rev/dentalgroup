{
  "$comment": "Behaviour settings for the server and the dashboard. Secrets, ports and paths stay in .env. The server reads this file at startup and serves it at GET /api/config; the dashboard reads it from there, so one edit changes both sides. Restart `npm run dev` after editing.",
  "dashboard": {
    "title": "P&L dashboard",
    "locale": "en-US",
    "currency": "USD",
    "defaultGranularity": "month",
    "defaultOffice": "all",
    "defaultRange": {
      "from": "2025-01",
      "to": "current",
      "snapToData": true
    },
    "defaultYoy": false,
    "granularities": [
      "month",
      "quarter",
      "year"
    ],
    "chartHeights": {
      "main": 320,
      "office": 280
    },
    "syncToastSeconds": {
      "success": 8,
      "error": 12
    }
  },
  "compare": {
    "maxOffices": 4,
    "minOffices": 2,
    "defaultMetric": "netIncome",
    "metrics": [
      "income",
      "expenses",
      "netIncome"
    ]
  },
  "officeChart": {
    "enabled": true,
    "maxOffices": 8,
    "metric": "netIncome"
  },
  "charts": {
    "$comment": "Chart forms offered by the picker on each chart; default is used on load. main: combo (income/expense bars + net income line) | lines | bars (grouped) | stacked (expense groups stacked, income and net income as lines). office: lines | bars (grouped) | stacked (part-to-whole) | small (one panel per office, shared scale) | ranked (total per office over the range). showPicker=false hides the pickers and uses the defaults.",
    "main": {
      "default": "combo",
      "options": [
        "combo",
        "lines",
        "bars",
        "stacked"
      ]
    },
    "office": {
      "default": "lines",
      "options": [
        "lines",
        "bars",
        "stacked",
        "small",
        "ranked"
      ]
    },
    "showPicker": true
  },
  "metrics": {
    "income": {
      "label": "Income",
      "upIsGood": true,
      "color": 1
    },
    "expenses": {
      "label": "Expenses",
      "upIsGood": false,
      "color": 2
    },
    "netIncome": {
      "label": "Net income",
      "upIsGood": true,
      "color": 3
    }
  },
  "groups": {
    "order": [
      "Income",
      "COGS",
      "Expenses",
      "OtherIncome",
      "OtherExpenses"
    ],
    "labels": {
      "Income": "Income",
      "COGS": "Cost of goods sold",
      "Expenses": "Expenses",
      "OtherIncome": "Other income",
      "OtherExpenses": "Other expenses"
    },
    "incomeGroups": [
      "Income",
      "OtherIncome"
    ],
    "expenseGroups": [
      "COGS",
      "Expenses",
      "OtherExpenses"
    ],
    "colors": {
      "Income": 1,
      "COGS": 2,
      "Expenses": 5,
      "OtherIncome": 6,
      "OtherExpenses": 7
    }
  },
  "sync": {
    "startDate": "2025-01-01",
    "endDate": "2026-12-31",
    "accountingMethod": "Accrual",
    "sequential": true
  },
  "qbo": {
    "minorVersion": 75,
    "refreshSkewMinutes": 5,
    "oauthStateTtlMinutes": 10
  }
}
