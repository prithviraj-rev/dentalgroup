{
  "name": "dentalgroup",
  "version": "0.1.0",
  "private": true,
  "description": "POC: pull QuickBooks Online P&L from multiple sandbox companies into SQLite and chart it",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "connect": "node server/index.js",
    "sync": "node scripts/sync.js",
    "dashboard": "concurrently -k -n api,web -c blue,magenta \"node server/index.js\" \"vite --config dashboard/vite.config.js\"",
    "build:dashboard": "vite build --config dashboard/vite.config.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "better-sqlite3": "~11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "vite": "^6.3.6"
  }
}
